# ========== QQ Bot 必填 ==========
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

# ========== QQ Bot 可选 ==========
# 机器人沙箱环境（默认正式环境，调试时可设为 sandbox）
QQ_BOT_ENV=production

# ========== AI 大模型（可选，不填则禁用 AI 对话功能）==========
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

IMAGE_API_KEY=
IMAGE_API_BASE=
IMAGE_MODEL=gpt-image-2

# ========== 腾讯云 COS（可选，不填则图片无法上传，QQ Bot需要图片可在公网访问）==========
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
# CDN 加速域名（可选，留空则用默认 COS 域名）
COS_CDN_DOMAIN=

# ========== 日志 ==========
LOG_LEVEL=INFO

# ========== Steam 视奸设置 ==========
# Cookie (填写后steam爬取会更稳定)
STEAM_COOKIE=
STEAM_POLL_INTERVAL=60
STEAM_MAX_CONCURRENT=100